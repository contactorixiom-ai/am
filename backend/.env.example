# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://axis:axis_dev@localhost:5432/axis_import?schema=public"

# Redis (cache, pub/sub for WebSockets)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too-different-from-above
JWT_REFRESH_EXPIRES_IN=30d

# File storage (local | s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_PUBLIC_URL=http://localhost:3000/uploads
# S3-compatible (used when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=eu-west-3
S3_BUCKET=axis-import
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Logging
LOG_LEVEL=debug
