# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://axis:axis_dev@localhost:5432/axis_import?schema=public"

# Redis (cache, pub/sub for WebSockets)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too-different-from-above
JWT_REFRESH_EXPIRES_IN=30d

# Stockage des fichiers (pièces KYC, photos de véhicule…)
# Seul le pilote « local » est implémenté ; STORAGE_DRIVER=s3 fait échouer
# le démarrage, volontairement, plutôt que d'échouer au premier upload.
STORAGE_DRIVER=local
# En production, ce chemin DOIT pointer sur un disque persistant, sinon les
# fichiers disparaissent au prochain déploiement. Sur Railway, il suffit
# d'attacher un volume au service : le chemin s'y range tout seul, cette
# variable devient inutile.
# STORAGE_LOCAL_PATH=/data/uploads
# Adresse publique des fichiers. Laissée vide, elle est déduite du domaine du
# service ; les fichiers sont servis par l'API, derrière authentification.
# STORAGE_PUBLIC_URL=
# Adresse publique de l'API, si elle n'est pas déductible automatiquement.
# PUBLIC_API_URL=https://mon-api.example.com/api/v1

# Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Logging
LOG_LEVEL=debug
