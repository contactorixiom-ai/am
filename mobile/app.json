{
  "expo": {
    "name": "Axis Import",
    "slug": "axis-import",
    "owner": "am27z",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "axisimport",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B2545"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.axisimport.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B2545"
      },
      "package": "com.axisimport.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "baseUrl": "/am/app"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Axis Import accède à vos photos pour joindre l'état des lieux du véhicule et vos documents.",
          "cameraPermission": "Axis Import utilise l'appareil photo pour l'état des lieux du véhicule (photos obligatoires au départ et à l'arrivée)."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://am-production-80d6.up.railway.app/api/v1"
    }
  }
}
