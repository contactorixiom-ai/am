{
  "name": "axis-import-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "android": "expo start --android",
    "build:apk": "eas build --platform android --profile preview",
    "build:devclient": "eas build --platform android --profile development",
    "check:native": "expo prebuild --platform android --no-install --clean && expo prebuild --platform ios --no-install --clean && rm -rf android ios",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "phone": "expo start --dev-client --tunnel",
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "type-check": "tsc --noEmit",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.2.3",
    "@expo/metro-runtime": "^56.0.14",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "axios": "^1.7.7",
    "expo": "~51.0.28",
    "expo-constants": "~16.0.2",
    "expo-dev-client": "~4.0.29",
    "expo-device": "~6.0.2",
    "expo-font": "~12.0.10",
    "expo-image-picker": "^15.0.7",
    "expo-linking": "~6.3.1",
    "expo-location": "~17.0.1",
    "expo-notifications": "^0.28.19",
    "expo-status-bar": "~1.12.1",
    "expo-system-ui": "~3.0.7",
    "expo-task-manager": "~11.8.2",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "react": "18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-maps": "1.14.0",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-web": "^0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/leaflet": "^1.9.22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~18.2.79",
    "typescript": "~5.3.3"
  }
}
